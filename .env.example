# PUBLIC frontend configuration only. Everything prefixed VITE_ is embedded in the browser bundle.
# Never put the service-role key, database password, access tokens or CAPTCHA/Edge secrets here.
#
# Local development: `npm run db:start` prints both values (API URL and the publishable/anon key).
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_PUBLISHABLE_KEY=
