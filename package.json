{
  "name": "tunnels",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "local:start": "node scripts/local-stack.mjs",
    "local:stop": "node scripts/local-stack.mjs stop",
    "test:e2e:local": "playwright test",
    "dev": "vite",
    "build": "npm run domain:check && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "npm run typecheck:domain && npm run typecheck:app && npm run typecheck:backend",
    "typecheck:domain": "tsc -p tsconfig.domain.json",
    "typecheck:app": "tsc -b",
    "typecheck:backend": "tsc -p tsconfig.backend.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest --project unit-domain --project unit-ui --project unit-backend",
    "test:unit": "vitest run --project unit-domain --project unit-ui --project unit-backend",
    "test:fast": "npm run domain:check && vitest run --project unit-domain --project unit-ui --project unit-backend --changed && npm run typecheck",
    "test:iteration": "npm run typecheck && npm run lint && npm run test:unit && npm run build",
    "test:integration": "vitest run --project integration",
    "domain:sync": "node scripts/domain-sync.mjs sync",
    "domain:check": "node scripts/domain-sync.mjs check",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db",
    "test:db:docker": "bash scripts/test-db-docker.sh",
    "test:backend:docker": "bash scripts/test-db-docker.sh --integration",
    "check:edge": "bash scripts/check-edge.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "postgres": "^3.4.9",
    "prettier": "^3.9.9",
    "supabase": "^2.119.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
